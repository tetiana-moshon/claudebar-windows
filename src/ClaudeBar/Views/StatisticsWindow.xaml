<Window x:Class="ClaudeBar.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code Statistics"
        Width="820" Height="620"
        MinWidth="760" MinHeight="570"
        Background="#FF1E1E20"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,18,24,18">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                <TextBlock Text="Statistics" FontSize="22" FontWeight="Bold" Foreground="#FFF2F2F7"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#FF9A9AA0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="UsageTabBtn" Content="Usage" Padding="14,4" Click="OnUsageTab"/>
                <ToggleButton x:Name="ActivityTabBtn" Content="Activity" Padding="14,4" Margin="6,0,0,0" Click="OnActivityTab"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#1AFFFFFF"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentHost" Margin="24"/>
        </ScrollViewer>
    </Grid>
</Window>
